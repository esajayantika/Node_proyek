<header class="head fw-bolder pt-1 pb-3 ps-3" style="background-color: #f8c76b; color:#3d2b1f;">
    <form autocomplete="off" class= "d-flex mt-4" id="searchForm">
      <div class="input-group w-50" style="max-width:400px;" >
        <input 
        type="text" 
        class="form-control border-dark" 
        placeholder="Lets Go.." 
        name = "keyword" 
        autocomplete="off"
        id="searchInput">
        <button class="btn btn-dark" type="submit"><i class="bi bi-search"></i></button>
      </div>
  </form>
    <title>Search Result: <%= keyword %></title>
    <div class="search-header mt-3" id="searchHeader">
        <h2>Result for "<%= keyword %>"</h2>
        <% if (resep && resep.meals && resep.meals.length>0) { %>
         <p>Found <%= resep.meals.length %> recipes</p>
        <% } else {%>
         <p>Found No recipes</p>
        <% } %>
    </div>
</header>
<div class="mx-auto" style="width: 100%; height: 7px; background-color: #3d2b1f;"></div>
<main class="container-fluid px-3 my-4" >
  <div class="row g-4" id="searchResult">
    <% if (resep && resep.meals && resep.meals.length>0) { %>
        <% resep.meals.slice(0,16).forEach(objek => { %>
          <div class="col-6 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="position-relative">
                    <img src= <%= objek.strMealThumb %> 
                    class="card-img-top" 
                    alt="<%= objek.strMeal %>"
                    style="height: 300px; width: 100%; object-fit: cover;">

                    <!-- judul -->
                    <div class="position-absolute bottom-0 start-0 end-0 px-3 py-2"
                        style="background: linear-gradient(to top, rgba(0,0,0,0.8),transparent);">
                        <h5 class="card-title text-white m-0 fs-15"> <%= objek.strMeal %>  </h5>
                    </div>
                </div>
                <!-- card body -->
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-body-secondary"><%= objek.strCountry %></h6>
                    <a href="#" class="btn btn-sm see-detail bg-opacity-50" style="background-color: #3d2b1f; color: #ffffff;" 
                        data-bs-toggle="modal" 
                        data-bs-target="#exampleModal" 
                        data-id="<%= objek.idMeal %>">
                        Read More
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div> 
            </div>  
         <% }) %>
    <% } else if (keyword && resep && !resep.meals) { %>
        <div class="col text-center py-5" style="color:#3d2b1f;">
            <h3>|--Recipe Not Found 😅--|</h3>
            <p>Try another/correct key</p>
            <a href="/" class="btn btn-sm" style="background-color: #3d2b1f; color: #ffffff;">Back</a>
        </div>
         <% } %>
  </div>
</main>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" >
  <div class="modal-dialog modal-lg">
    <div class="modal-content" style="background-color: #FFF9F5;">
      <div class="modal-header">
        <h1 class="modal-title fs-5 w-100 text-center" id="exampleModalLabel">Detail Recipe</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" >
        
      </div>
      <div class="modal-footer">
        <button type="button" id="add-fav" class="btn btn-danger">Add to Myfav</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
   
  </div>
</div>
<div id="fav-message"></div>
<script src="/js/script.js"></script>