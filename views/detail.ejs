<div class="cotainer mt-3">
    <div class="row">
        <div class="col-md-8">
            <h2>Detail Supplier</h2>
            <% if (!contact) { %>
                <div class="alert alert-danger fw-bold" role="alert">
                    Data supplier tidak ada !!! <br /> <a href="/contact" class="alert-link fw-light">&laquo; kembali ke daftar supplier</a>
                </div>
            <% } else{ %>
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title"><%= contact.nama %></h5>
                        <h6 class="card-subtitle mb-2 text-body-secondary"><%= contact.nomor %></h6>
                        <p class="card-text"><%= contact.email %></p>
                        <a href="/contact/edit/<%= contact.nama %>" class="btn btn-info badge">Edit</a>
                        <form action="/contact?_method=DELETE" method="POST" class="d-inline">
                            <input type="hidden" name="nama" value="<%= contact.nama %>"/>
                            <button type="submit" class="btn btn-danger badge" onclick="return confirm('Yakin Hapus Data?')">Hapus</button>
                        </form>
                        <a href="/contact" class="card-link d-block mt-3">&laquo; Kembali</a>
                    </div>
                </div>
            <%} %> 
        </div>
    </div>
</div>