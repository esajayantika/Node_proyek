<div class="container">
    <div class="row">
        <div class="col-md-8">
        <h2>My Favourites</h2>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">No</th>
                    <th scope="col">Recipe Name</th>
                    <th scope="col">Country</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                <% if (myfavs.length === 0) { %>
                <tr>
                    <td colspan="4">
                        <div class="alert alert-danger fw-bold" role="alert">
                            Data My Favourites masih Kosong !!!
                        </div>
                    </td>
                </tr>
                <% } %>
                <% myfavs.forEach((myfav,i) => {%>
                <tr>
                    <th scope="row"><%= i+1%></th>
                    <td><%= myfav.strMeal %></td>
                    <td><%= myfav.strCountry %></td>
                    <td class="text-center">
                        <div class="d-flex gap-1 justify-content-center">
                            <a href="/export-pdf/<%= myfav.idMeal %>" class="btn btn-warning btn-sm">
                                <i class="bi bi-filetype-pdf"></i>PDF
                            </a>
                            <button class="btn btn-danger btn-sm delete" data-id="<%= myfav.idMeal %>"> 
                                <i class="bi bi-trash"></i>Delete
                            </button>
                        </div>
                    </td>
                </tr>
                <%})%>
            </tbody>
        </table>
        </div>
    </div>
</div>
<div id="fav-message"></div>
<script src="/js/myfav.js"></script>