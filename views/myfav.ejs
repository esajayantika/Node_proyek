<div class="container">
    <div class="row">
        <div class="col-md-8">
        <h2>My Favourites</h2>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">No</th>
                    <th scope="col">Recipe Name</th>
                    <th scope="col">Country</th>
                    <th colspan="2" class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                <% if (myfavs.length === 0) { %>
                <tr>
                    <td colspan="4">
                        <div class="alert alert-danger fw-bold" role="alert">
                            Data My Favourites masih Kosong !!!
                        </div>
                    </td>
                </tr>
                <% } %>
                <% myfavs.forEach((myfav,i) => {%>
                <tr>
                    <th scope="row"><%= i+1%></th>
                    <td><%= myfav.strMeal %></td>
                    <td><%= myfav.strCountry %></td>
                    <td class="text-end pe-1"><a href="/export-pdf/<%= myfav.idMeal %>" class="btn btn-warning"><i class="bi bi-filetype-pdf"></i> Eksport</a></td>
                    <td class="text-start ps-1"><button class="btn btn-danger delete" data-id="<%= myfav.idMeal %>">Delete</button></td>
                </tr>
                <%})%>
            </tbody>
        </table>
        </div>
    </div>
</div>
<div id="fav-message"></div>
<script src="/js/myfav.js"></script>