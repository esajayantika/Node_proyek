<div class="row mt-3 justify-content-center">
  <div class="col-md-8">
     <!-- Header-->
        <header class="bg-primary bg-gradient text-white">
            <div class="container px-4 text-center">
                <h1 class="fw-bolder">Welcome to Scrolling Nav</h1>
                <p class="lead">A functional Bootstrap 5 boilerplate for one page scrolling websites</p>
                <a class="btn btn-lg btn-light" href="#about">Start scrolling!</a>
            </div>
        </header>
    <h1 class="text-center">
      Cari Resep Di Seluruh Dunia!
    </h1>
    <form action="/" method="get" autocomplete="off">
    <div class="input-group mb-3" action >
      <input type="text" class="form-control" placeholder="Masukkan nama makanan" name = "keyword" autocomplete="off">
      <button class="btn btn-dark" type="submit">Search</button>
    </div>
    </form>
  </div>
<hr>
  <div class="row">
    <% if (keyword && resep && resep.meals) { %>
        <% resep.meals.slice(0,12).forEach(objek => { %>
          <div class="col-md-4">
            <div class="card mb-3">
                <img src= <%= objek.strMealThumb %> class="card-img-top" alt="...">
                    <div class="card-body">
                        <h5 class="card-title"> <%= objek.strMeal %>  </h5>
                        <h6 class="card-subtitle mb-2 text-body-secondary"> <%= objek.strCountry %></h6>
                        <a href="#" class="card-link see-detail" data-bs-toggle="modal" data-bs-target="#exampleModal" data-id="<%= objek.idMeal %>">See Detail</a>
                    </div>
            </div> 
            </div>  
         <% }) %>
    <% } else if (keyword && resep && !resep.meals) { %>
        <div class="col">
            <h1 class="text-center">--Resep Tidak Ditemukan--</h1>
        </div>
         <% } %>
  </div>
</div>
<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Resep Detail</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        
      </div>
      <div class="modal-footer">
        <button type="button" id="add-fav" class="btn btn-danger">Add to Myfav</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
   
  </div>
</div>
<div id="fav-message"></div>
<script src="/js/script.js"></script>